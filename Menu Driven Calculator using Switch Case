#include <stdio.h>
int main() 
{ float a,b,res;
  int option;
  printf("\n Enter 1st number: ");
  scanf("%f", &a);
  printf("\n Enter 2nd number: ");
  scanf("%f", &b);

  printf("\n Press1: Addition");
  printf("\n Press2: Subtraction");
  printf("\n Press3: Multiply");
  printf("\n Press4: Division");

  printf("\n Enter your choice: ");
  scanf("%d", &option);

  switch(option)
  {case 1:
   res=a+b;
   printf("Sum is: %f",res);
   break;
   case 2:
   res=a-b;
   printf("Difference is: %f",res);
   break;
   case 3:
   res=a*b;
   printf("Product is: %f",res);
   break;
   case 4:
   res=a/b;
   printf("Product is: %f",res);
   break;
   default:
   printf("Invalid Option Selected");
      }
 return 0;
}
