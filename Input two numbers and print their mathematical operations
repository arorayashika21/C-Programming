//WAP to input two numbers and print their sum, difference, product, quotient, and remainder. 
#include <stdio.h>

int main() {
int a,b, sum, diff, product, quotient, remainder;
    printf("\n Enter 1st Number: ");
    scanf("%d", &a);

    printf("\n Enter 2nd Number: ");
    scanf("%d", &b);
    
    sum= a+b;
    printf("\n The sum is: %d",sum);
    
    diff= a-b;
    printf("\n The difference is: %d",diff);
    
    product= a*b;
    printf("\n The product is: %d",product);
    
    quotient= a/b;
    printf("\n The quotient is: %d",quotient);
    
    remainder= a%b;
    printf("\n The remainder is: %d",remainder); 
 
         
  return 0;
  }

